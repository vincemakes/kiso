{
  "schema": 2,
  "id": "no-console",
  "description": "Console output belongs in the CLI layer only.",
  "level": "error",
  "files": [
    "js",
    "ts"
  ],
  "enabled": true,
  "match": {
    "pattern": "\\bconsole\\.(log|warn|error)\\(",
    "message": "console call"
  },
  "fix": null,
  "options": {
    "allowIn": [
      "src/cli.mjs"
    ]
  },
  "tags": [
    "correctness"
  ],
  "examples": {
    "bad": [
      "console.log(1)"
    ],
    "good": [
      "out.write(1)"
    ]
  }
}
