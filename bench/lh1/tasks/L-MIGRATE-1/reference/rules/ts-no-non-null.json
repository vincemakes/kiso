{
  "schema": 2,
  "id": "ts-no-non-null",
  "description": "The non-null assertion hides a real check.",
  "level": "warn",
  "files": [
    "ts"
  ],
  "enabled": true,
  "match": {
    "pattern": "[A-Za-z0-9_$)\\]]!\\.",
    "message": "non-null assertion"
  },
  "fix": null,
  "options": {},
  "tags": [
    "types"
  ],
  "examples": {
    "bad": [
      "a!.b"
    ],
    "good": [
      "a?.b"
    ]
  }
}
