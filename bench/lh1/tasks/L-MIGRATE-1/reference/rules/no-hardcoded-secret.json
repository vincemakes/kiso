{
  "schema": 2,
  "id": "no-hardcoded-secret",
  "description": "Strings that look like keys must not be committed.",
  "level": "error",
  "files": [
    "*"
  ],
  "enabled": true,
  "match": {
    "pattern": "(?:api|secret)[_-]?key\\s*[:=]\\s*[\"'][A-Za-z0-9]{16,}",
    "message": "possible hard-coded secret"
  },
  "fix": null,
  "options": {},
  "tags": [
    "security"
  ],
  "examples": {
    "bad": [
      "api_key = \"abcdefghijklmnop\""
    ],
    "good": [
      "api_key = env.KEY"
    ]
  }
}
