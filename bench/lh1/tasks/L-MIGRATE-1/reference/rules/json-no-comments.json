{
  "schema": 2,
  "id": "json-no-comments",
  "description": "JSON has no comments.",
  "level": "error",
  "files": [
    "json"
  ],
  "enabled": true,
  "match": {
    "pattern": "^\\s*//",
    "message": "comment in JSON"
  },
  "fix": null,
  "options": {},
  "tags": [
    "correctness"
  ],
  "examples": {
    "bad": [
      "// x"
    ],
    "good": [
      "{}"
    ]
  }
}
