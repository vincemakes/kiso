{
  "id": "md-trailing-hashes",
  "description": "Closing hashes on headings are noise.",
  "severity": 0,
  "when": "md",
  "enabled": "yes",
  "pattern": "^#{1,6} .*#+\\s*$",
  "message": "closing hashes",
  "fix": "strip",
  "options": {},
  "tags": [
    "markdown",
    "style"
  ],
  "examples": {
    "bad": [
      "# T #"
    ],
    "good": [
      "# T"
    ]
  }
}
