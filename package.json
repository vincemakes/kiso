{
  "name": "@kiso/core",
  "version": "0.0.0",
  "description": "kiso(基礎) — the agent kernel that actually works. ~2,000 lines, every decision documented.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./adapters": "./src/adapters/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "adrs"
  ],
  "scripts": {
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run size && npm run test",
    "demo": "tsx scripts/demo.ts"
  },
  "keywords": [
    "agent",
    "llm",
    "kernel",
    "minimal",
    "anthropic",
    "openai"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.100",
    "openai": ">=5.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^26.1.2",
    "openai": "^7.3.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
