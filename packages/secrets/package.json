{
	"name": "@vincemakes/kiso-secrets",
	"version": "0.57.0",
	"description": "kiso secrets — one secret detector for kiso: the credential-file set, the child-environment strip, the secret-location deny list and shape-only content patterns. Zero dependencies and zero imports, so it bundles anywhere.",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"typescript": "^5.7.2",
		"vitest": "^3.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vincemakes/kiso.git",
		"directory": "packages/secrets"
	},
	"bugs": {
		"url": "https://github.com/vincemakes/kiso/issues"
	},
	"homepage": "https://github.com/vincemakes/kiso/tree/main/packages/secrets#readme"
}
