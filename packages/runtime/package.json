    "@kiso/evals": { "optional": true },
    "@kiso/provider-anthropic": { "optional": true },
    "@kiso/provider-openai": { "optional": true },
    "openai": { "optional": true }
  },
  "devDependencies": {
    "@kiso/evals": "*",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.2",
