{
	"name": "@vincemakes/kiso-client",
	"version": "0.47.3",
	"description": "kiso client — the typed client for a hosted kiso session over the wire protocol: run, resume, abort, approve, the snapshot, and a stream that reconnects with Last-Event-ID and never repeats an event. Browser and Node; depends on the protocol package only.",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@vincemakes/kiso-protocol": "0.47.3"
	},
	"devDependencies": {
		"@vincemakes/kiso-core": "0.47.3",
		"@vincemakes/kiso-evals": "0.47.3",
		"@vincemakes/kiso-runtime": "0.47.3",
		"@vincemakes/kiso-server": "0.47.3",
		"@types/node": "^26.1.2",
		"typescript": "^5.7.2",
		"vitest": "^3.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vincemakes/kiso.git",
		"directory": "packages/client"
	},
	"bugs": {
		"url": "https://github.com/vincemakes/kiso/issues"
	},
	"homepage": "https://github.com/vincemakes/kiso/tree/main/packages/client#readme"
}
