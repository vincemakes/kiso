{
	"name": "@vincemakes/kiso-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "kiso desktop (spike) \u2014 an Electron shell around the hosted-session service.",
	"type": "module",
	"main": "dist/main/main.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && vite build",
		"typecheck": "tsc -p tsconfig.json",
		"check": "npm run build && npm run typecheck && node scripts/check-imports.mjs",
		"start": "electron .",
		"proofs": "node scripts/proofs/all.mjs"
	},
	"dependencies": {
		"@vincemakes/kiso-client": "0.51.1",
		"@vincemakes/kiso-code": "0.51.1",
		"@vincemakes/kiso-core": "0.51.1",
		"@vincemakes/kiso-protocol": "0.51.1",
		"@vincemakes/kiso-provider-openai": "0.51.1",
		"@vincemakes/kiso-runtime": "0.51.1",
		"@vincemakes/kiso-server": "0.51.1",
		"@vincemakes/kiso-tools-node": "0.51.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vincemakes/kiso-evals": "0.51.1",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "44.9.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^5.7.2",
		"vite": "8.3.4"
	},
	"engines": {
		"node": ">=22"
	}
}
