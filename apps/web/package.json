{
	"name": "@vincemakes/kiso-web",
	"version": "0.52.0",
	"private": false,
	"description": "kiso web: a local web app on the hosted-session service, served on 127.0.0.1.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"kiso-web": "dist/main/headless.js"
	},
	"files": [
		"dist/main",
		"dist/shared",
		"out/renderer",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && vite build",
		"typecheck": "tsc -p tsconfig.json",
		"check": "npm run build && npm run typecheck && npm run gates && npm run proofs:fast",
		"gates": "node scripts/gates/size.mjs && node scripts/gates/deps.mjs && node scripts/gates/imports.mjs && node scripts/gates/names.mjs && node scripts/gates/paths.mjs && node ../../scripts/check-cjk.mjs",
		"proofs:fast": "node scripts/proofs/all.mjs fast",
		"proofs:full": "node scripts/proofs/all.mjs full",
		"check:full": "npm run build && npm run typecheck && npm run gates && npm run proofs:full",
		"start": "node dist/main/headless.js"
	},
	"dependencies": {
		"@vincemakes/kiso-client": "0.52.0",
		"@vincemakes/kiso-code": "0.52.0",
		"@vincemakes/kiso-core": "0.52.0",
		"@vincemakes/kiso-protocol": "0.52.0",
		"@vincemakes/kiso-provider-openai": "0.52.0",
		"@vincemakes/kiso-runtime": "0.52.0",
		"@vincemakes/kiso-server": "0.52.0",
		"@vincemakes/kiso-tools-node": "0.52.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vincemakes/kiso-evals": "0.52.0",
		"@vitejs/plugin-react": "6.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^5.7.2",
		"vite": "8.3.4"
	},
	"engines": {
		"node": ">=22"
	},
	"os": [
		"darwin",
		"linux"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vincemakes/kiso.git",
		"directory": "apps/web"
	},
	"bugs": {
		"url": "https://github.com/vincemakes/kiso/issues"
	},
	"homepage": "https://github.com/vincemakes/kiso/tree/main/apps/web#readme"
}
