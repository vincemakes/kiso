{
	"name": "@vincemakes/kiso-code",
	"version": "0.52.0",
	"description": "kiso-code \u2014 the coding agent on kiso, the durable runtime for AI agents: kiso chat / kiso resume / kiso sessions.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"kiso": "dist/index.js"
	},
	"exports": {
		"./config": {
			"types": "./dist/config-door.d.ts",
			"default": "./dist/config-door.js"
		},
		"./policy": {
			"types": "./dist/policy.d.ts",
			"default": "./dist/policy.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@vincemakes/kiso-ask-ext": "0.52.0",
		"@vincemakes/kiso-core": "0.52.0",
		"@vincemakes/kiso-evals": "0.52.0",
		"@vincemakes/kiso-mcp-ext": "0.52.0",
		"@vincemakes/kiso-provider-anthropic": "0.52.0",
		"@vincemakes/kiso-provider-openai": "0.52.0",
		"@vincemakes/kiso-provider-openai-responses": "0.52.0",
		"@vincemakes/kiso-runtime": "0.52.0",
		"@vincemakes/kiso-skills-ext": "0.52.0",
		"@vincemakes/kiso-subagent-ext": "0.52.0",
		"@vincemakes/kiso-tools-node": "0.52.0",
		"@vincemakes/kiso-tui": "0.52.0",
		"@vincemakes/kiso-tui-cells": "0.52.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"typescript": "^5.7.2",
		"vitest": "^3.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"os": [
		"darwin",
		"linux"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vincemakes/kiso.git",
		"directory": "apps/cli"
	},
	"bugs": {
		"url": "https://github.com/vincemakes/kiso/issues"
	},
	"homepage": "https://github.com/vincemakes/kiso/tree/main/apps/cli#readme"
}
